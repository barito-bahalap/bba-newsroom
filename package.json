{
  "name": "bba-newsroom",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Internal newsroom CMS for Barito Bahalap Media (BBM). Not public-facing.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "update:kit": "pnpm update \"@barito-bahalap/*\" --latest"
  },
  "dependencies": {
    "@barito-bahalap/components": "^1.16.2",
    "@barito-bahalap/config": "^1.3.0",
    "@barito-bahalap/styles": "^1.4.1",
    "@barito-bahalap/supabase": "^1.0.3",
    "@tanstack/react-query": "^5.101.2",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@barito-bahalap/ts-config": "^1.0.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "packageManager": "pnpm@12.10.1"
}
